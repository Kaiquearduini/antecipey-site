# Supabase (service role: só no servidor, nunca no navegador)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# Senha do painel /admin
ADMIN_PASSWORD=

PORT=3000

# Área do Cliente
SESSION_SECRET=          # 48+ caracteres aleatórios (assina o login do cliente)
INTEGRACAO_API_KEY=      # chave da jornada (PWA) para /api/integracao
ANTHROPIC_API_KEY=       # assistente virtual (Claude); sem ela o chat avisa que está indisponível
SAC_WHATSAPP=            # ex.: 5511999999999
SAC_TELEFONE=            # ex.: 08001234567 ou 1140041234
SAC_HORARIO=             # opcional, ex.: Segunda a sexta, das 9h às 18h
